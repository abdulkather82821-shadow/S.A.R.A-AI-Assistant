# Google Gemini API Key - get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Change the model without rebuilding the application
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API Key - get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# S.A.R.A's voice on ElevenLabs (Sarah - Warm & Crisp American Female)
ELEVENLABS_VOICE_ID=r1KmysJdVYZjJCm4mL3b

# Optional: system location (latitude, longitude) - auto-detected if blank
SARA_LATITUDE=
SARA_LONGITUDE=

# Optional: owner name (how S.A.R.A addresses you)
SARA_OWNER_NAME=Sir
